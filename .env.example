# Copy this file to .env and fill in your own values. Never commit .env.

# Meta Model API key (https://dev.meta.ai) - used for SAM 3.1, Muse models and Muse Voice Transcribe
MODEL_API_KEY=your-meta-model-api-key-here

# fal.ai key - only needed for the optional SAM 3D visuals
FAL_KEY=

# Logging: DEBUG, INFO, WARNING or ERROR
LAPLACE_LOG_LEVEL=INFO
